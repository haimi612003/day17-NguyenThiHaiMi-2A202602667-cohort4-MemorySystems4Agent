# Copy to .env (gitignored) and fill in. Only needed for `python src/benchmark.py --live`.

# Main agent model: openai | custom | gemini | anthropic | ollama | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# Optional judge model for response quality (defaults to the main model)
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o-mini

# API keys / endpoints (fill the one matching your provider)
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# CUSTOM_BASE_URL=http://localhost:8000/v1
# CUSTOM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Memory knobs
# COMPACT_THRESHOLD_TOKENS=800
# COMPACT_KEEP_MESSAGES=4
# PROFILE_CONFIDENCE_THRESHOLD=0.7
# PROFILE_MAX_LIST_ITEMS=6
# PROFILE_DECAY_RATE=0.9
